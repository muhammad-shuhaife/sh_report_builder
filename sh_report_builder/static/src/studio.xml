<?xml version='1.0' encoding='utf-8'?>
<templates xml:space="preserve">
<t t-name="sh_report_builder.Studio">
<div class="rb-studio h-100 overflow-auto">
    <div class="rb-studio-top"><div><span class="rb-studio-label">REPORT STUDIO</span><h1>Make every report yours.</h1></div><div class="d-flex gap-2 flex-wrap"><div class="o_cp_switch_buttons d-inline-flex btn-group" role="group" aria-label="Report views"><button class="btn btn-secondary o_switch_view" t-on-click="this.openList" aria-label="List (Tree)" data-tooltip="List (Tree) view"><i class="oi oi-fw" data-icon="reorder" aria-hidden="true"/></button><button class="btn btn-secondary o_switch_view active" t-on-click="this.showReports" aria-current="page" aria-label="Studio" data-tooltip="Studio view"><i class="oi oi-fw" data-icon="oi_view-kanban" aria-hidden="true"/></button></div></div></div>
    <div t-if="this.state.screen === 'reports'" class="rb-studio-body">
        <section class="rb-report-welcome"><div><span class="rb-studio-label">YOUR REPORT WORKSPACE</span><h2>Start with a spark.</h2><p>Pick a layout, make it yours, and turn your data into a report worth sharing.</p></div><button class="btn rb-new-report" t-on-click="this.newReport" aria-label="New report"><span class="rb-new-orb" aria-hidden="true">+</span><span class="rb-new-label"><strong>New report</strong><small>Explore the design library</small></span></button></section><h2 class="rb-collection-title"><t t-if="this.state.reports.length">My reports</t><t t-else="">Your reports will appear here</t></h2><div class="rb-studio-grid"><button t-foreach="this.state.reports" t-as="report" t-key="report.id" class="rb-report-card" t-on-click="() =&gt; this.openReport(report.id)"><img t-att-src="'/sh_report_builder/static/gallery/' + (report.page_design === 'none' ? 'classic' : report.page_design) + '.png'" alt="Layout illustration" loading="lazy"/><div class="p-3"><span t-att-class="'rb-report-status ' + (report.state === 'published' ? 'rb-status-published' : 'rb-status-draft')"><span class="rb-status-dot" aria-hidden="true"/><span><t t-if="report.state === 'published'">Published</t><t t-else="">Draft</t></span></span><h3 t-out="report.name"/><p class="text-muted" t-out="report.model_name"/><span>Open designer →</span></div></button></div>
    </div>
    <div t-else="" class="rb-studio-body">
        <div class="rb-gallery-steps"><button t-att-class="'btn rb-step ' + (this.state.screen === 'gallery' ? 'is-active' : '')" t-on-click="() =&gt; this.state.screen = 'gallery'"><span class="rb-step-number" aria-hidden="true">1</span><span>Page gallery</span></button><button t-att-class="'btn rb-step ' + (this.state.screen === 'lines' ? 'is-active' : '')" t-on-click="() =&gt; this.state.screen = 'lines'"><span class="rb-step-number" aria-hidden="true">2</span><span>Table designs</span></button><button t-att-class="'btn rb-step ' + (this.state.screen === 'textures' ? 'is-active' : '')" t-on-click="() =&gt; this.state.screen = 'textures'"><span class="rb-step-number" aria-hidden="true">3</span><span>In-page designs</span></button><button t-att-class="'btn rb-step ' + (this.state.screen === 'preview' ? 'is-active' : '')" t-on-click="() =&gt; this.state.screen = 'preview'"><span class="rb-step-number" aria-hidden="true">4</span><span>Preview &amp; configure</span></button><button class="btn rb-custom-button" t-on-click="() =&gt; this.configure(true)" t-att-disabled="this.state.busy">Create my own</button></div>
        <t t-if="this.state.screen === 'gallery'"><h2>Choose your page design</h2><p class="text-muted">Eighteen layouts, from classic letterheads to geometric Studio originals.</p><div class="rb-studio-grid"><button t-foreach="this.state.designs" t-as="design" t-key="design.key" t-att-aria-label="design.name" t-att-class="'rb-design-card ' + (this.state.page === design.key ? 'selected' : '')" t-on-click="() =&gt; this.choosePage(design.key)"><div class="rb-design-thumb"><img t-att-src="design.preview" t-att-alt="design.name" loading="lazy"/></div><div class="rb-design-caption"><h3 t-out="design.name"/><span t-if="this.state.page === design.key" aria-label="Selected">✓</span></div></button></div><div class="rb-studio-actions"><span>Selected: <t t-out="this.selectedDesign?.name"/></span><button class="btn rb-next-button" t-on-click="() =&gt; this.state.screen = 'lines'">Choose table design →</button></div></t>
        <t t-if="this.state.screen === 'lines'"><h2>Choose your table &amp; line design</h2><p class="text-muted">Apply independently to any page layout.</p><div class="rb-studio-grid"><button t-foreach="this.state.lines" t-as="line" t-key="line.key" t-att-aria-label="line.name" t-att-class="'rb-design-card ' + (this.state.line === line.key ? 'selected' : '')" t-on-click="() =&gt; this.chooseLine(line.key)"><div t-att-class="'rb-table-sample rb-lines-' + line.key"><table><thead><tr><th>Description</th><th>Qty</th><th>Amount</th></tr></thead><tbody><tr><td>Office desk</td><td>2</td><td>480.00</td></tr><tr><td>Task chair</td><td>4</td><td>320.00</td></tr><tr><td>Storage unit</td><td>1</td><td>200.00</td></tr></tbody></table></div><div class="rb-design-caption"><h3 t-out="line.name"/><span t-if="this.state.line === line.key">✓</span></div></button></div><div class="rb-studio-actions"><button class="btn rb-back-button" t-on-click="() =&gt; this.state.screen = 'gallery'">← Page designs</button><button class="btn rb-next-button" t-on-click="() =&gt; this.state.screen = 'textures'">Choose in-page design →</button></div></t>
        <t t-if="this.state.screen === 'textures'">
    <h2>Choose an in-page design</h2><p class="text-muted">Textures apply behind body content. Header/footer artwork and report positions stay independent.</p>
    <div class="rb-texture-controls"><div><label for="rb-texture-opacity">Texture opacity <strong><t t-out="this.state.opacity"/>%</strong></label><input id="rb-texture-opacity" type="range" min="0" max="100" step="1" t-att-value="this.state.opacity" t-on-input="this.setOpacity"/><p class="small text-muted mb-0">Adjust every texture below together, then select your favourite. Your chosen opacity is kept for the report.</p></div></div>
    <div class="rb-studio-grid">
        <button t-att-class="'rb-design-card ' + (this.state.body === 'none' ? 'selected' : '')" t-on-click="() =&gt; this.chooseBody('none')"><div class="rb-design-thumb d-flex align-items-center justify-content-center"><span class="text-muted">No body texture</span></div><div class="rb-design-caption"><h3>Plain body</h3><span t-if="this.state.body === 'none'">✓</span></div></button>
        <button t-foreach="this.state.textures" t-as="texture" t-key="texture.key" t-att-aria-label="texture.name" t-att-class="'rb-design-card ' + (this.state.body === texture.key ? 'selected' : '')" t-on-click="() =&gt; this.chooseBody(texture.key)"><div class="rb-design-thumb rb-texture-thumb"><div class="rb-texture-sheet"><div class="rb-texture-art" t-att-style="'opacity:' + this.state.opacity / 100 + ';background-image:url(&quot;' + texture.texture + '&quot;);background-size:' + (texture.tiled ? '32px 32px' : '100% 100%')"/><div class="rb-texture-ink"><strong>Your company</strong><h4>Quotation</h4><p>Customer · SO00042</p><table><thead><tr><th>Description</th><th>Amount</th></tr></thead><tbody><tr><td>Office desk</td><td>480.00</td></tr><tr><td>Task chair</td><td>320.00</td></tr><tr><td>Storage unit</td><td>200.00</td></tr></tbody></table><p class="rb-texture-total">Total  $1,000.00</p></div></div></div><div class="rb-design-caption"><h3 t-out="texture.name"/><span t-if="this.state.body === texture.key">✓</span></div></button>
    </div><div class="rb-studio-actions"><button class="btn rb-back-button" t-on-click="() =&gt; this.state.screen = 'lines'">← Table designs</button><button class="btn rb-next-button" t-on-click="() =&gt; this.state.screen = 'preview'">Preview &amp; configure →</button></div>
</t>
<div t-if="this.state.screen === 'preview'" class="rb-studio-preview">
    <div class="rb-preview-paper"><div t-if="this.state.previewBusy" class="small text-muted mb-2" role="status">Updating your combination…</div><div t-if="this.state.previewError" class="alert alert-warning" t-out="this.state.previewError"/><iframe title="Selected report combination" sandbox="" t-att-srcdoc="this.state.previewHtml"/></div>
    <div><span class="rb-studio-label">YOUR DESIGN</span><h2>Everything, together.</h2><p class="text-muted">Your page artwork, table styling and in-page texture are combined in one illustrative report.</p>
    <div class="rb-selection-summary"><span>Page design</span><strong t-out="this.selectedDesign?.name"/><span>Table design</span><strong t-out="this.selectedLine?.name"/><span>In-page design</span><strong t-out="this.state.textures.find((item) =&gt; item.key === this.state.body)?.name || 'Plain body'"/><span>Texture opacity</span><strong><t t-out="this.state.opacity"/>%</strong></div>
    <label class="mt-4 d-block" for="rb-preview-opacity">Texture opacity</label><input id="rb-preview-opacity" type="range" min="0" max="100" step="1" t-att-value="this.state.opacity" t-on-input="this.setOpacity" t-att-disabled="this.state.body === 'none'"/>
    <button class="btn rb-next-button mt-4" t-on-click="() =&gt; this.configure(false)" t-att-disabled="this.state.busy">Use this combination </button><p class="text-muted mt-3">Next: choose a report type, model, branding and paper format. Business data is selected in the report editor.</p></div></div>
    </div>
</div>
</t>
</templates>
